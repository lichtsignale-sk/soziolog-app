# Reverse-Proxy mit automatischem TLS (Let's Encrypt) für die Produktion.
# CADDY_DOMAIN und ACME_EMAIL kommen aus der .env. Für einen lokalen Test
# (CADDY_DOMAIN=localhost) nutzt Caddy ein internes, selbstsigniertes Zertifikat.
{
	email {$ACME_EMAIL:admin@example.com}
}

{$CADDY_DOMAIN:localhost} {
	encode gzip

	# API ans NestJS-Backend weiterleiten (TLS terminiert hier, dahinter http).
	handle /api/* {
		reverse_proxy api:3000
	}

	# Alles andere: die statische PWA (nginx serviert die SPA + Fallback).
	handle {
		reverse_proxy web:80
	}
}
