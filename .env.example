# Datenbank
DATABASE_URL=postgresql://soziolog:soziolog@localhost:5432/soziolog?schema=public

# API
# ACHTUNG: `change-me` ist ein PLATZHALTER. Eine Instanz mit NODE_ENV=production
# startet damit nicht mehr — sie bricht mit einer Meldung ab, die sagt, was
# fehlt. Einen echten Wert erzeugen: openssl rand -hex 32
JWT_SECRET=change-me
SESSION_SECRET=change-me
PORT=3000

# Schlüssel zur AES-GCM-Verschlüsselung der Systemkonfiguration (z. B. SMTP-Daten).
# Fällt auf SESSION_SECRET zurück, wenn nicht gesetzt. In Prod eigenen Wert setzen.
CONFIG_KEY=change-me

# Session-/CSRF-Cookies: Secure verlangt HTTPS. Lokal (http) auf 0 setzen,
# sonst wird das Cookie nicht gesendet und der Login schlägt fehl. In Prod = 1.
COOKIE_SECURE=0

# SMTP – im Dev auf Mailhog zeigen (SMTP_HOST=localhost, SMTP_PORT=1025;
# im Docker-Netz SMTP_HOST=mailhog). Ist SMTP_HOST leer, loggt die API die
# Mail inkl. Reset-Link nur in die Konsole.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me
SMTP_FROM=SozioLog <noreply@example.com>
# Transportverschluesselung des Postausgangs. Vorgabe (auch ohne die Variable):
# erzwungen -- bietet die Gegenstelle kein STARTTLS an, wird NICHT versendet,
# sondern ein Fehler gemeldet. Ueber diesen Weg gehen die Passwort-Reset-Links
# hinaus. Nur 0 schaltet ab, und nur ausserhalb von NODE_ENV=production; dort
# bricht die API den Start ab. Die Ausnahme ist fuer Mailpit/Mailhog gedacht.
SMTP_TLS_ERZWINGEN=1

# App-URL (für CORS in der API). In Prod die öffentliche HTTPS-Domäne, z. B.
# https://soziolog.example.com
APP_URL=http://localhost:5173

# --- Nur für den Produktions-Stack (docker-compose.prod.yml) ---
# Datenbank-Passwort (die prod-DATABASE_URL wird daraus zusammengesetzt).
POSTGRES_PASSWORD=change-me
# Domäne für Caddy (automatisches TLS via Let's Encrypt). Lokal: localhost.
CADDY_DOMAIN=localhost
# E-Mail für die Let's-Encrypt-Registrierung.
ACME_EMAIL=admin@example.com
# Aufbewahrung der täglichen DB-Backups in Tagen.
BACKUP_RETENTION_DAYS=14

# Optional: Fehler-Tracking
# SENTRY_DSN=

# Frontend (Vite)
# VITE_API_URL=http://localhost:3000
# VITE_SENTRY_DSN=
# VITE_DEBUG=0

# Anzahl der Proxys vor der API. Hinter Coolify (Traefik + nginx): 2 — das
# setzen die Coolify-Compose-Dateien selbst. docker-compose.prod.yml (Caddy,
# ein Sprung) setzt FEST 1 und liest diesen Wert bewusst nicht. Nur fuer den
# Betrieb ohne beides hier setzen; bei direktem Zugriff ohne Proxy: 0. Eine
# falsche, aber gueltige Zahl laeuft still durch — also mitzaehlen.
# TRUST_PROXY=2
